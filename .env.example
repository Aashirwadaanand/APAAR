# =============================================================================
# SIH26263 APAAR Enrolment Integrity Platform - Environment Template
# =============================================================================

# --- Backend Web Service Settings ---
PORT=8000
ENVIRONMENT=development

# Render Persistent Storage Mount Path (Production: /var/data/apaar_institute.db)
# In local development, leave blank or point to local SQLite file:
DATABASE_PATH=./apaar_institute.db
# Or use full connection URL:
DATABASE_URL=sqlite:///./apaar_institute.db

# Allowed CORS Origins (comma-separated or JSON list)
# In production on Render, set this to your Render Static Site URL:
# Example: https://apaar-integrity-frontend.onrender.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional: Shortcut to add a single deployed frontend origin
FRONTEND_URL=

# Safeguard to allow resetting demo records in production (Leave false in production)
ALLOW_PRODUCTION_DEMO_RESET=false

# Simulation Settings
SIMULATION_LATENCY_MS=400
INSTITUTION_ID=AICTE-1-432890123
INSTITUTION_NAME="Apex Institute of Technology & Management (AICTE Approved)"

# --- Frontend Static Site Settings ---
# In production on Render, set this in the Static Site service environment:
# Example: https://apaar-integrity-backend.onrender.com
VITE_API_BASE_URL=
